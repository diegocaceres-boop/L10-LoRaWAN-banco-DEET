    {
        "id": "53360c503d46d0e3",
        "type": "function",
        "z": "tabL9",
        "name": "function 1",
        "func": "// Practica L10 - Listado L10.6: nodo function de Node-RED detras de un \"mqtt in\" (salida:\n// objeto JSON) suscrito a  application/+/device/+/event/up  en el broker del laboratorio,\n// 192.168.1.50. Con UNA salida hay que devolver [[m1, m2, m3, m4]] (los cuatro, en\n// secuencia, por la misma salida) hacia un \"mqtt out\" sin tema fijo; el [m1, ..., m4] del\n// listado de la guia reparte un mensaje por salida y exige configurar 4 salidas.\n// Salida: los mismos topicos que ya consume el tablero de L9, mas la calidad del enlace.\nlet up = msg.payload;\nlet d = up.uplink_message ? up.uplink_message.decoded_payload    // TTS\n                          : up.object;                           // ChirpStack\nif (!d) { return null; }\nlet meta = up.uplink_message ? up.uplink_message.rx_metadata[0] : up.rxInfo[0];\n\nreturn [[\n  { topic: \"planta/lorawan/temperatura\", payload: d.temperatura },\n  { topic: \"planta/lorawan/nivel\", payload: d.nivel },\n  { topic: \"planta/lorawan/alarma\",\n    payload: (d.alarma_temp || d.alarma_nivel) ? 1 : 0 },\n  { topic: \"planta/lorawan/calidad\",\n    payload: { rssi: meta.rssi, snr: meta.snr, medio: \"LoRaWAN\", ts_nodo: d.ts_iso } }\n]];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 340,
        "wires": [
            [
                "ca16284bb6bbe4ab",
                "b09bdd5887ea74c1"
            ]
        ]
    },
